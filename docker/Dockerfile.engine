# ==========================================
# 1. PRUNE STAGE
# ==========================================
FROM node:22-alpine AS pruner
WORKDIR /app
RUN apk add --no-cache libc6-compat
RUN npm install -g turbo
COPY . .
# Scoping to "engine" (name from package.json)
RUN turbo prune --scope=engine --docker

# ==========================================
# 2. INSTALL & BUILD STAGE
# ==========================================
FROM node:22-alpine AS builder
WORKDIR /app
RUN apk add --no-cache libc6-compat
RUN npm install -g pnpm

# Copy package files (json) first for caching
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

# Copy source code
COPY --from=pruner /app/out/full/ .

# Build the project
# This runs "tsc -b" inside the engine folder
RUN pnpm run build --filter=engine...

# ==========================================
# 3. RUNNER STAGE
# ==========================================
FROM node:22-alpine AS runner
WORKDIR /app
RUN apk add --no-cache openssl

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nodejs
USER nodejs

# 1. Copy node_modules
COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules

# 2. Copy the built artifact
# ⚠️ CHECK THIS PATH: If your folder is named "packages/engine", change "apps/engine" below.
COPY --from=builder --chown=nodejs:nodejs /app/apps/engine/dist ./dist

# 3. Copy package.json (Optional)
COPY --from=builder --chown=nodejs:nodejs /app/apps/engine/package.json ./package.json

# 4. Environment Variables
# If you use Redis, you might need to pass ENV vars here or via docker-compose
# ENV REDIS_URL=... 

# Your package.json says "node dist/index.js"
CMD ["node", "dist/index.js"]