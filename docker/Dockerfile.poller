FROM node:20-alpine

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy the entire repository
COPY . .

# Remove local .env files to ensure we use Docker environment variables
RUN rm -f .env apps/*/.env packages/*/.env

# Install dependencies
RUN pnpm install

# Build the specific app using Turbo to ensure dependencies are built
RUN pnpm exec turbo run build --filter=price_poller...

WORKDIR /app/apps/price_poller

CMD ["node", "dist/index.js"]
