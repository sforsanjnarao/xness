FROM node:20-alpine

WORKDIR /app

# Accept build arguments for Next.js public env vars
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# Install pnpm
RUN npm install -g pnpm

# Copy the entire repository
COPY . .

# Remove local .env files to ensure we use Docker environment variables
RUN rm -f .env apps/*/.env packages/*/.env

# Install dependencies
RUN pnpm install


# Build the specific app using Turbo to ensure dependencies are built
RUN pnpm exec turbo run build --filter=web...

WORKDIR /app/apps/web

EXPOSE 3000

CMD ["pnpm", "start"]
