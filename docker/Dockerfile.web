# ==========================================
# 1. PRUNE STAGE
# ==========================================
FROM node:22-alpine AS base

FROM base AS pruner
WORKDIR /app
RUN apk add --no-cache libc6-compat
RUN npm install -g turbo
COPY . .
# Scoping to "web" (the name in package.json)
RUN turbo prune --scope=web --docker

# ==========================================
# 2. INSTALL & BUILD STAGE
# ==========================================
FROM base AS builder
WORKDIR /app
RUN apk add --no-cache libc6-compat
RUN npm install -g pnpm

# Copy package files
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY --from=pruner /app/out/full/ .

# Build the project
# This triggers 'next build' which creates the .next/standalone folder
RUN pnpm run build --filter=web...

# ==========================================
# 3. RUNNER STAGE
# ==========================================
FROM base AS runner
WORKDIR /app

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Set correct permissions
USER nextjs

# 1. Copy the "Standalone" build
# Next.js bundles only the necessary node_modules here.
# It preserves the folder structure, so it will be at /app/apps/web/server.js
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./

# 2. Copy Static Assets (Images, CSS, JS chunks)
# Standalone mode does NOT include these by default, so we must copy them manually.
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public

# 3. Environment variables
ENV NODE_ENV production
ENV PORT 3000
ENV HOSTNAME "0.0.0.0"

EXPOSE 3001

# Run the server.js file generated by Next.js
CMD ["node", "apps/web/server.js"]