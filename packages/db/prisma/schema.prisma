// @map = rename a column
// @@map = rename a table
generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String
  orders   Order[] // Renamed from 'order' to 'orders' (Prisma convention)
  wallet   Wallet?

  @@map("user")
}

model Wallet {
  id         String   @id @default(uuid())
  
  // 1-to-1 Relation
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  
  // Default to USDC so you don't have to specify it
  asset      Asset    @default(USDC) 
  
  balanceRaw BigInt
  
  createdAt  DateTime @default(now()) @map("create_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("wallet")
}

model Order {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  user            User        @relation(fields: [userId], references: [id])
  
  market          Market
  side            orderSide
  status          orderStatus

  // QUANTITY
  quantity        BigInt
  // Removed quantityDecimal (Handle this in your TS Config/Constants)

  // PRICES - Changed to BigInt to prevent overflow
  openPrice       BigInt      @map("open_price")
  closePrice      BigInt?     @map("close_price") 
  // Removed priceDecimals (Handle this in your TS Config/Constants)

  // MARGIN & LEVERAGE
  leverage        Int         @default(1)
  initialMargin   BigInt      @map("initial_margin")
  
  // PNL - Made optional. Only exists when Closed.
  Pnl             BigInt?     @map("profit_and_loss")

  // TRIGGERS - Changed to BigInt
  takeProfitPrice BigInt?     @map("take_profit")
  stopLossPrice   BigInt?     @map("stop_loss")

  reason          CloseReason?

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime?   @updatedAt @map("updated_at")
  closedAt        DateTime?   @map("closed_at")

  @@map("order")
}

enum Asset {
  USDC
}

enum Market {
  BTC_USDC
  SOL_USDC
  ETH_USDC
}

enum orderSide {
  LONG
  SHORT
}

enum orderStatus {
  OPEN
  CLOSED
  LIQUIDATION
  @@map("order_status")
}

enum CloseReason {
  take_profit
  stop_loss
  manual
  liquidation
  @@map("close_reason")
}